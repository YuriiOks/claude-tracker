{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "tracker-orchestrator",
  "env": {
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "4",
    "ANTHROPIC_SMALL_FAST_MODEL": "haiku",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "statusLine": {
    "type": "command",
    "args": ["bash", "${CLAUDE_PROJECT_DIR}/.claude/hooks/status-line.sh"],
    "refreshInterval": 3000
  },
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run preview:*)",
      "Bash(npm install:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm run dev:*)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(open docs/*)",
      "Bash(open /Users/yurii_jupus/Documents/Personal/claude-tracker/docs/*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Edit(backend/.env)",
      "Write(backend/.env)",
      "Edit(.env.docker)",
      "Write(.env.docker)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git branch -D:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Edit(src/data.js)",
      "Write(src/data.js)",
      "Edit(src/styles.css)",
      "Write(src/styles.css)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "id": "session-start:branch-and-stack-banner",
        "description": "Print branch + dev-server status + recent docs at session start",
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start-banner.sh"]
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "id": "post-compact:invariants",
        "description": "Refresh invariants after compaction",
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-compact-invariants.sh"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "id": "stop:pre-stop-checklist",
        "description": "Pre-stop reminder",
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-stop-checklist.sh"]
          }
        ]
      },
      {
        "id": "stop:draft-errors",
        "description": "If this session had Bash commands that failed 2+ times with the same prefix, draft an ERRORS.md.draft for /log-error promote review.",
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-draft-errors.sh"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "id": "post:edit-write:eslint",
        "description": "Run eslint --fix on JS/JSX/CSS edits",
        "matcher": "Edit|Write",
        "if": "Edit(*.js)|Edit(*.jsx)|Edit(*.css)|Write(*.js)|Write(*.jsx)|Write(*.css)",
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-use-eslint.sh"],
            "continueOnBlock": true
          }
        ]
      },
      {
        "id": "post:bash:track-failures",
        "description": "Silently record non-zero Bash exits for /log-error auto-draft at session stop.",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-use-track-failures.sh"]
          }
        ]
      },
      {
        "id": "post:edit-write:ruff",
        "description": "Run ruff --fix on Python edits inside backend/",
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-use-ruff.sh"]
          }
        ]
      }
    ]
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Yurii is hopping between repos",
      "Cyan is repurposing itself as amber",
      "Mocking data.js one more shape",
      "Counting permissions across the workspace",
      "Lazy-loading the Graph",
      "Tweaking the tweaks panel",
      "Toggling data-theme in DevTools",
      "Eyeballing both themes",
      "Sliding window of 60 events",
      "Grepping every consumer",
      "Pretending the dashboard is real",
      "Bora codar"
    ]
  }
}
