{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "tracker-orchestrator",
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run preview:*)",
      "Bash(npm install:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm run dev:*)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(open docs/*)",
      "Bash(open /Users/yurii_jupus/Documents/Personal/claude-tracker/docs/*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Edit(backend/.env)",
      "Write(backend/.env)",
      "Edit(.env.docker)",
      "Write(.env.docker)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git branch -D:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Edit(src/data.js)",
      "Write(src/data.js)",
      "Edit(src/styles.css)",
      "Write(src/styles.css)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "id": "session-start:branch-and-stack-banner",
        "description": "Print branch + dev-server status + recent docs at session start",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"${CLAUDE_PROJECT_DIR:-$HOME/Documents/Personal/claude-tracker}\" 2>/dev/null && BRANCH=$(git branch --show-current 2>/dev/null) && DEV_UP=$(lsof -ti:5173 2>/dev/null | wc -l | tr -d \" \") && DOCS=$(ls docs/*.html 2>/dev/null | wc -l | tr -d \" \") && echo \"\ud83d\udcca claude-tracker | branch: $BRANCH | vite: $([ \"$DEV_UP\" -ge 1 ] && echo running || echo stopped) | $DOCS doc(s) in docs/\"'"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "id": "post-compact:invariants",
        "description": "Refresh invariants after compaction",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\ud83d\udd01 claude-tracker invariants: 1) HTML-first docs (skill: html-docs) 2) Vanilla CSS, tokens-only (rules: vanilla-css, dual-theme) 3) data.js is the contract \u2014 grep before renaming (rules: data-shape-contract; agent: data-shape-keeper) 4) Both themes must work \u2014 light cyan == amber 5) No router lib, no state lib, no TS yet (agent: react-engineer) 6) Default agent: tracker-orchestrator \u2014 delegates to react-engineer / data-shape-keeper / doc-author'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "id": "stop:pre-stop-checklist",
        "description": "Pre-stop reminder",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\u270b Before stopping: did you run npm run lint? if backend touched, did you run make test? did you eyeball both themes? did you grep src/components/ for any data.js keys you renamed?'"
          }
        ]
      },
      {
        "id": "stop:draft-errors",
        "description": "If this session had Bash commands that failed 2+ times with the same prefix, draft an ERRORS.md.draft for /log-error promote review.",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-draft-errors.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "id": "post:edit-write:eslint",
        "description": "Run eslint --fix on JS/JSX edits",
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-use-eslint.sh"
          }
        ]
      },
      {
        "id": "post:bash:track-failures",
        "description": "Silently record non-zero Bash exits for /log-error auto-draft at session stop.",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-use-track-failures.sh"
          }
        ]
      },
      {
        "id": "post:edit-write:ruff",
        "description": "Run ruff --fix on Python edits inside backend/",
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-use-ruff.sh"
          }
        ]
      }
    ]
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Yurii is hopping between repos",
      "Cyan is repurposing itself as amber",
      "Mocking data.js one more shape",
      "Counting permissions across the workspace",
      "Lazy-loading the Graph",
      "Tweaking the tweaks panel",
      "Toggling data-theme in DevTools",
      "Eyeballing both themes",
      "Sliding window of 60 events",
      "Grepping every consumer",
      "Pretending the dashboard is real",
      "Bora codar"
    ]
  }
}
