# Copy to .env.docker and edit for your machine. .env.docker is gitignored.
# Used by docker-compose.yml only — bare-metal runs use backend/.env.

# ─── Host paths (read-only mounts) ───────────────────────────────────────────
# Path to your Claude data directory on the HOST (defaults to ~/.claude).
CLAUDE_DIR_HOST=${HOME}/.claude

# Parent directory whose subtrees contain the repos you want tracked.
# Mounted at /host/home inside the container.
# Defaults to your home directory — narrow it if you prefer.
REPO_PARENT_HOST=${HOME}

# ─── Container-side config ──────────────────────────────────────────────────
# REPO_ROOTS must be CONTAINER paths under /host/home/...
# Example: if you have ~/Desktop/jupus on the host, the container path is
#   /host/home/Desktop/jupus
REPO_ROOTS=/host/home/Desktop/jupus,/host/home/Desktop/voice,/host/home/Documents/Personal/claude-tracker

# Logging
LOG_LEVEL=INFO

# ─── LAN mode ────────────────────────────────────────────────────────────────
# Off by default: the frontend port stays 127.0.0.1-only and this setting is
# moot. Don't flip it here directly -- use `make docker-up-lan`, which sets
# LAN_MODE=1 and LAN_BIND=0.0.0.0 for that one invocation (docker-compose.yml
# reads both from the shell environment, same convention as LOG_LEVEL above).
# See CLAUDE.md "Phone / LAN access" / README.md for what LAN_MODE changes.
LAN_MODE=0

# ─── Optional integrations (Phase F) ────────────────────────────────────────
# Leave blank to disable. The adapters return None gracefully if absent.
LINEAR_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
GITHUB_TOKEN=
