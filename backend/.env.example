# Copy to .env and edit. .env is gitignored.

# Path to ~/.claude (or the equivalent on your system).
CLAUDE_DIR=~/.claude

# Comma-separated list of repo paths to track. Each must be a git repo with optional .claude/.
REPO_ROOTS=~/Desktop/jupus,~/Desktop/voice,~/Desktop/anita,~/Documents/Personal/claude-tracker

# SQLite cache file. Created on first run.
DB_PATH=./.cache/tracker.db

# uvicorn bind. Localhost only. (Port 8000 is commonly taken by Docker/Django.)
HOST=127.0.0.1
PORT=8765

# CORS — frontend origin during dev.
FRONTEND_ORIGIN=http://localhost:5173

LOG_LEVEL=INFO
